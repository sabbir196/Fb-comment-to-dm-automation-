      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1400, 300],
      "webhookId": "fb-comment-webhook-post"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-2",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.FB_VERIFY_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1a1a1a-0003-4000-8000-000000000003",
      "name": "If - Verify Facebook Webhook",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1180, 0],
      "notes": "Checks hub.mode = subscribe AND hub.verify_token matches FB_VERIFY_TOKEN env variable"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "1a1a1a1a-0004-4000-8000-000000000004",
      "name": "Respond - Return hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-960, -100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": {
          "responseCode": 403
        }
      },
      "id": "1a1a1a1a-0005-4000-8000-000000000005",
      "name": "Respond - Verification Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-960, 100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {
          "responseCode": 200
        }
      },
      "id": "1a1a1a1a-0006-4000-8000-000000000006",
      "name": "Respond - Event Received",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-field",
              "leftValue": "={{ $json.body.entry[0].changes[0].field }}",
              "rightValue": "feed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-item",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.item }}",
              "rightValue": "comment",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1a1a1a-0007-4000-8000-000000000007",
      "name": "If - Only Comment Events",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-960, 300],
      "notes": "Ignores likes, shares, reactions, and other page events"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-1",
              "name": "postId",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.post_id }}"
            },
            {
              "id": "assign-2",
              "name": "userName",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.from.name }}"
            },
            {
              "id": "assign-3",
              "name": "userComment",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.message }}"
            },
            {
              "id": "assign-4",
              "name": "commentId",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.comment_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1a1a1a-0008-4000-8000-000000000008",
      "name": "Extract Comment Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-740, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Campaigns"
        },
        "options": {}
      },
      "id": "1a1a1a1a-0009-4000-8000-000000000009",
      "name": "Google Sheets - Read Campaigns",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-520, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "id": "1a1a1a1a-0010-4000-8000-000000000010",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [-380, 520],
      "credentials": {
        "openRouterApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"isValid\": \"boolean\",\n  \"dmMessage\": \"string\",\n  \"publicReply\": \"string\"\n}"
      },
      "id": "1a1a1a1a-0011-4000-8000-000000000011",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [-260, 520]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Post ID: {{ $json.postId }}\nUser Name: {{ $json.userName }}\nUser Comment: {{ $json.userComment }}\n\nCampaign data (from Google Sheets): {{ JSON.stringify($('Google Sheets - Read Campaigns').all().map(i => i.json)) }}",
        "options": {
          "systemMessage": "You are a moderator and customer support assistant.\n\nYour tasks:\n1. Read campaign data from Google Sheets (Campaign Name, Post ID, Trigger Keyword, Resource Link).\n2. Match the incoming Post ID.\n3. Detect whether the user's comment expresses genuine intent to receive the resource (matching the Trigger Keyword).\n4. Ignore irrelevant or abusive comments (isValid = false).\n5. Generate all responses in the target language configured for this deployment.\n\nOutput MUST follow this exact JSON schema:\n{\n  \"isValid\": boolean,\n  \"dmMessage\": string,\n  \"publicReply\": string\n}\n\nIf isValid = false, keep dmMessage and publicReply as empty strings."
        },
        "hasOutputParser": true
      },
      "id": "1a1a1a1a-0012-4000-8000-000000000012",
      "name": "AI Agent - Intent Detection",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [-380, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-isvalid",
              "leftValue": "={{ $json.output.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1a1a1a-0013-4000-8000-000000000013",
      "name": "If - isValid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-140, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.FB_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  recipient: { comment_id: $('Extract Comment Data').item.json.commentId },\n  message: { text: $json.output.dmMessage }\n}) }}",
        "options": {}
      },
      "id": "1a1a1a1a-0014-4000-8000-000000000014",
      "name": "HTTP Request - Send DM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Extract Comment Data').item.json.commentId }}/comments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.FB_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.output.publicReply }) }}",
        "options": {}
      },
      "id": "1a1a1a1a-0015-4000-8000-000000000015",
      "name": "HTTP Request - Send Public Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 400]
    }
